# Plantilla de /etc/sgpmp/edge-agent.env (permisos 0600, dueño del servicio).
# Copiar, completar con los valores del ambiente (guía privada
# GUIA_CONEXION_IOT_<AMBIENTE>.md) y NUNCA versionar el archivo real.

# --- Broker ---------------------------------------------------------------
EDGE_MQTT_HOST=
# Default 1883, o 8883 si se define EDGE_MQTT_CA_CERT.
#EDGE_MQTT_PORT=
EDGE_MQTT_USERNAME=sgpmp_devices
EDGE_MQTT_PASSWORD=
# Ruta al CA del broker. Obligatorio antes de salir a campo (plan, M1).
#EDGE_MQTT_CA_CERT=/etc/sgpmp/ca.pem
# Default edge-<primer serial>. Debe ser único entre todos los dispositivos.
#EDGE_MQTT_CLIENT_ID=
#EDGE_MQTT_KEEPALIVE_S=60

# --- Identidad ------------------------------------------------------------
# Uno o varios seriales de modulo9.dispositivos_iot, separados por coma.
EDGE_SERIALS=

# --- Parámetros operativos (RF-60 R1: sin valores fijos en código) --------
# Período máximo de heartbeat; el efectivo es min(esto, frecuencia_captura/2).
EDGE_HEARTBEAT_INTERVAL_S=300
# Config inicial hasta que llegue el primer comando RF-23 (minutos).
EDGE_FRECUENCIA_CAPTURA_MIN=10
EDGE_INTERVALO_TRANSMISION_MIN=15

# --- Almacenamiento local -------------------------------------------------
#EDGE_BUFFER_PATH=/var/lib/sgpmp-edge/buffer.db
#EDGE_BUFFER_MAX_ROWS=50000
#EDGE_STATE_PATH=/var/lib/sgpmp-edge/config.json

# --- Fuente de datos --------------------------------------------------------
# "fake" (datos sintéticos, pruebas sin radio) o "lora" (SX1276 real).
EDGE_SOURCE=fake
# Solo fake: nombre:unidad:min:max separados por ';'. `nombre` debe existir
# en modulo9.variables_ambientales o el broker rechaza la telemetría.
#EDGE_FAKE_VARIABLES=temperatura_ambiente:C:20:30

# --- LoRa (EDGE_SOURCE=lora) — ver docs/PROTOCOLO_LORA.md ---------------------
# Frecuencia y potencia: obligatorias, según la regulación de la ANE [confirmar].
#EDGE_LORA_FREQ_HZ=915000000
#EDGE_LORA_TX_POWER_DBM=14
# Deben coincidir con el firmware de los ESP32 (platformio.ini).
#EDGE_LORA_SF=9
#EDGE_LORA_BW_HZ=125000
#EDGE_LORA_CR=5
#EDGE_LORA_SYNC_WORD=0x12
#EDGE_LORA_NET_ID=0x01
# node_id=serial. Serial por ESP32: 1=IOT-A,2=IOT-B.
# Serial por sitio: 1=IOT-SITIO,2=IOT-SITIO. Todos los seriales deben estar
# en EDGE_SERIALS.
#EDGE_LORA_NODES=1=IOT-EST01-HLA-001
# code=nombre:unidad (nombre en modulo9.variables_ambientales).
#EDGE_LORA_VARIABLES=1=temperatura_ambiente:C;2=humedad_relativa:%
# Cableado SPI (spidev0.0 = CE0) y pin de reset opcional (numeración BCM).
#EDGE_LORA_SPI_BUS=0
#EDGE_LORA_SPI_DEVICE=0
#EDGE_LORA_RESET_GPIO=25
#EDGE_LORA_DOWNLINK_DELAY_MS=50

#EDGE_LOG_LEVEL=INFO
